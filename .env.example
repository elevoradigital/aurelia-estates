# Aurelia Estates Environment Variables & Production Configuration
# Copy this file to .env.local for local overrides or configure in your deployment platform (Vercel, Cloud Run, AWS)

# Base canonical site URL (update with your actual production domain upon deployment)
NEXT_PUBLIC_SITE_URL=https://aureliaestates.elevora.com

# Transactional Email Dispatch (Resend API)
# When configured, verified client viewing requests will dispatch emails to CONTACT_EMAIL.
# When omitted, inquiries are durably stored in the server ledger (data/inquiries.json) with honest client feedback.
RESEND_API_KEY=
CONTACT_EMAIL=advisory@elevora.example.com
EMAIL_FROM=inquiry@aureliaestates.example.com

# Spline 3D Scene Asset (Optional - if interactive 3D massing model is integrated)
NEXT_PUBLIC_SPLINE_SCENE_URL=
